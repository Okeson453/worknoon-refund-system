{
  "name": "@worknoon/api",
  "version": "1.0.0",
  "private": true,
  "description": "WORKNOON refund API: validation, deterministic policy engine, AI layer, audit trail",
  "license": "MIT",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build --workspace @worknoon/shared-types && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "npm run build --workspace @worknoon/shared-types && prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@prisma/client": "6.19.3",
    "@worknoon/shared-types": "1.0.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
