# WORKNOON refund system — environment template.
# Copy to .env before `docker compose up --build`. Never commit the real .env.

NODE_ENV=development

# PostgreSQL 16 service in docker-compose. The db container uses the same credentials.
DATABASE_URL=postgresql://postgres:postgres@db:5432/worknoon

# AI layer. Use `mock` for a deterministic, key-free run.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=10000
AI_MIN_CONFIDENCE=0.6

# Deterministic policy. Changing these changes real money decisions, so they are audited.
REFUND_WINDOW_DAYS=30
ESCALATION_THRESHOLD_USD=500

# Optional bearer token for the support endpoints. Empty keeps them open for the demo.
ADMIN_API_KEY=

# Published ports
PORT=4000
WEB_PORT=3000

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
